# Optional overrides — mspbots-agent-db has no required env vars.
# Authentication is per-request via two headers (provided by the MCP caller):
#   X-MSP-Api-Key    Agent Data Core API key for this tenant. Forwarded
#                    verbatim as "X-API-Key: <key>" to the pg-data-ingest API.
#   X-MSP-Host       Base host for the Agent Data Core API, e.g.
#                    https://agentint.mspbots.ai — this server appends
#                    "/apps/pg-data-ingest/api/agent-data/agents/<agentId>/..."
#                    to it.
#
# agent_id is NOT a header — every tool takes it as a plain argument (see
# README "Known Gaps" for the isolation tradeoff this implies).

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

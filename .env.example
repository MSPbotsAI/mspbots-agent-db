# Optional overrides — mspbots-agent-data-mcp has no required env vars.
# Authentication is per-request via three headers (provided by the MCP caller):
#   X-MSP-Api-Key    Agent Data Core API key for this tenant. Forwarded
#                    verbatim as "X-API-Key: <key>" to the pg-data-ingest API.
#   X-MSP-Agent-Id   The single agent this connector is scoped to. Every
#                    tool call reads/queries only this agent's partition —
#                    it is never accepted as a tool argument, so the calling
#                    LLM cannot redirect a call at a different agent's data
#                    (see README "Known Gaps" for why this matters).
#   X-MSP-Host       Base host for the Agent Data Core API, e.g.
#                    https://agentint.mspbots.ai — this server appends
#                    "/apps/pg-data-ingest/api/agent-data/agents/<agentId>/..."
#                    to it.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
